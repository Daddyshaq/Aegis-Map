# =============================================================================
# Aegis Map — Production Environment Configuration
# Copy this file to `.env.production` on your server and populate with real values.
# NEVER commit your populated `.env.production` file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage, Realtime)
# Get these from your Supabase Dashboard: Settings > API & Settings > Database
# -----------------------------------------------------------------------------
# Public Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Public Anon Key (safe for browser & client usage)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key

# Server-only credentials (NEVER expose to the browser)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key
# Secret Service Role Key (bypasses RLS, used exclusively by Fastify API)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-secret-service-role-key
# JWT Secret (Settings > API > JWT Settings > JWT Secret, used to verify tokens)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# Direct Postgres URI (used for running migrations and seed scripts)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# 2. Production Domain, URLs & CORS
# -----------------------------------------------------------------------------
# Base URL for the public Web Application
PRODUCTION_DOMAIN=aegismap.yourdomain.com

# API URL reached by the user's browser:
# If using the reverse proxy (Caddy/Nginx) under single domain: https://aegismap.yourdomain.com/api
# If hosting API on a subdomain: https://api.aegismap.yourdomain.com
VITE_API_URL=https://aegismap.yourdomain.com/api

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGIN=https://aegismap.yourdomain.com

# -----------------------------------------------------------------------------
# 3. Google Maps Platform & What3Words API
# -----------------------------------------------------------------------------
# Google Maps API Key: Create at https://console.cloud.google.com/
# Restrict in Google Cloud Console with HTTP referrers: https://aegismap.yourdomain.com/*
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...your-google-maps-api-key
GOOGLE_MAPS_API_KEY=AIzaSy...your-google-maps-api-key

# Google Maps Vector Map ID (optional, default: DEMO_MAP_ID)
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# What3Words API Key: Obtain from https://developer.what3words.com/
W3W_API_KEY=your-what3words-api-key
W3W_BASE_URL=https://api.what3words.com/v3

# -----------------------------------------------------------------------------
# 4. Map View Defaults (OpenStreetMap & Tile Settings)
# -----------------------------------------------------------------------------
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_DEFAULT_LAT=9.0765
VITE_MAP_DEFAULT_LNG=7.3986
VITE_MAP_DEFAULT_ZOOM=6

# -----------------------------------------------------------------------------
# 5. Web Push Notifications (VAPID)
# Generate a new production pair using: pnpm --filter @crisis/api gen:vapid
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=BNx...your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_SUBJECT=mailto:admin@yourdomain.com
VITE_VAPID_PUBLIC_KEY=BNx...your-public-vapid-key

# -----------------------------------------------------------------------------
# 6. API Server & Worker Settings
# -----------------------------------------------------------------------------
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=8080
LOG_LEVEL=info
RATE_LIMIT_MAX=150
RATE_LIMIT_WINDOW=1 minute
MAX_UPLOAD_BYTES=15728640
EXPIRY_SWEEP_MINUTES=15

# Geocoding & Routing Providers
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=

ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_API_KEY=
