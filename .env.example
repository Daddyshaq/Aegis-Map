# =============================================================================
# Aegis Map — Environment Configuration
# Copy this file to `.env` (and `apps/web/.env.local`, `apps/api/.env`) and fill in.
# NEVER commit real secrets. Only VITE_* variables are exposed to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — public (safe for the browser)
# -----------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Anon/public key. RLS protects data; this key is designed to be public.
VITE_SUPABASE_ANON_KEY=your-local-anon-key

# -----------------------------------------------------------------------------
# Supabase — server-only (NEVER expose to the browser)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
# Service role bypasses RLS. Server-side only. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
# JWT secret used to verify Supabase access tokens on the API.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Direct Postgres connection (migrations / admin scripts / integration tests)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Global request rate limit (requests / window / IP).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Max multipart upload size in bytes (default 15MB).
MAX_UPLOAD_BYTES=15728640

# -----------------------------------------------------------------------------
# Web app
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
# MapLibre style JSON URL. Defaults to a free OpenStreetMap raster style.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Default map center (Nigeria — Abuja) and zoom.
VITE_MAP_DEFAULT_LAT=9.0765
VITE_MAP_DEFAULT_LNG=7.3986
VITE_MAP_DEFAULT_ZOOM=6

# -----------------------------------------------------------------------------
# Mapping / Geocoding provider abstraction
# -----------------------------------------------------------------------------
# One of: nominatim | maptiler | google
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=

# -----------------------------------------------------------------------------
# Routing provider abstraction
# -----------------------------------------------------------------------------
# One of: osrm | openrouteservice | graphhopper
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_API_KEY=

# -----------------------------------------------------------------------------
# Web Push (VAPID). Generate with: pnpm --filter @crisis/api gen:vapid
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@aegismap.example
# Public VAPID key is also needed in the browser to subscribe.
VITE_VAPID_PUBLIC_KEY=
