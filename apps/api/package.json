{
  "name": "@crisis/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:vapid": "node --input-type=module -e \"import wp from 'web-push'; const k=wp.generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY='+k.publicKey); console.log('VAPID_PRIVATE_KEY='+k.privateKey);\"",
    "clean": "rimraf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@crisis/config": "workspace:*",
    "@crisis/database": "workspace:*",
    "@crisis/types": "workspace:*",
    "@crisis/utils": "workspace:*",
    "@crisis/validation": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@supabase/supabase-js": "^2.45.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "jose": "^5.6.3",
    "pino-pretty": "^11.2.2",
    "tsup": "^8.2.3",
    "typescript": "^5.5.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/web-push": "^3.6.3",
    "tsx": "^4.16.2",
    "vitest": "^2.0.5"
  }
}
